NODE_ENV=development
PORT=4000

# MySQL (Hostinger: hPanel -> Databases -> MySQL Databases; remote access needs "Remote MySQL" enabled)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u750189796_ai
DB_USER=u750189796_pilot
DB_PASSWORD=
DB_SSL=false

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Optional. Any OpenAI-compatible API. Without it the built-in rule-based parser is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

# Web Push. Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. Firebase service-account JSON (inline or a file path) to wake the Android app for instant alarm sync.
FCM_SERVICE_ACCOUNT_JSON=

# Comma-separated. Include the Capacitor origins for the Android app.
CORS_ORIGIN=http://localhost:5173,https://localhost,capacitor://localhost

RUN_WORKER_IN_PROCESS=true
WORKER_INTERVAL_MS=30000
DEFAULT_TIMEZONE=Asia/Kolkata

# First admin account (created on npm run migrate). Use this to open /admin.
ADMIN_EMAIL=admin@lifepilot.local
ADMIN_PASSWORD="LifePilot#Admin2026"
