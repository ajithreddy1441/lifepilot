# LifePilot API — paste these into the Vercel project for lifepilot-48t1.vercel.app
# Settings → Environment Variables → Production (and Preview). Then Redeploy.
#
# Do not put AI keys or DB passwords in the frontend project.

NODE_ENV=production
PORT=4000

# Hostinger MySQL — from Vercel you cannot use localhost.
# hPanel → Databases → the hostname shown there (often srvXXXX.hstgr.io).
# Also enable Remote MySQL and allow % (or Vercel) or the API cannot connect.
DB_HOST=
DB_PORT=3306
DB_NAME=u750189796_ai
DB_USER=u750189796_pilot
DB_PASSWORD=
DB_SSL=true

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Optional. Never set these on the frontend.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lifepilot.local
FCM_SERVICE_ACCOUNT_JSON=

# Frontend origins (login will fail CORS without these).
CORS_ORIGIN=https://lifepilot-sooty.vercel.app,https://lifepilot-didlxekna-ajithreddy1441s-projects.vercel.app,https://localhost,capacitor://localhost

# Vercel functions die after each request — do not run the reminder worker here.
RUN_WORKER_IN_PROCESS=false
WORKER_INTERVAL_MS=30000
DEFAULT_TIMEZONE=Asia/Kolkata

ADMIN_EMAIL=admin@lifepilot.local
ADMIN_PASSWORD="LifePilot#Admin2026"
