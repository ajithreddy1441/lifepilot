# Backend base URL. Leave empty in local dev (Vite proxies /api to localhost:4000).
# Production / Android app: the full HTTPS URL of the API, e.g. https://yourdomain.com
VITE_API_URL=

# Set true only when google-services.json is in mobile/android/app (FCM).
# Without it, PushNotifications.register() would crash the app.
VITE_ENABLE_FCM=false

